# ---------------------------------------------------------------------------
# Production Coach - environment template
#
# Every variable below is read by code in this repo. Verified by grepping
# process.env / import.meta.env across bot/, server/ and src/ - if you add one
# here that nothing reads, it becomes a trap for the next person.
#
# Copy to .env (root, for the API server) and bot/.env (for the agent).
# Both are gitignored. This repo is PUBLIC - never commit a filled-in copy.
# ---------------------------------------------------------------------------


# === API server (server/index.js) ==========================================

# IONOS Model Hub - powers Dr. Zay's chat responses. Required for /api/chat.
IONOS_API_KEY=
# Optional; these are the defaults baked into the server.
IONOS_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_CHAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ElevenLabs - text to speech. Required for /api/tts.
# NOTE the underscore between ELEVEN and LABS: the server reads
# ELEVEN_LABS_API_KEY, not ELEVENLABS_API_KEY. Getting this wrong means TTS
# silently reports "not configured" with no other error.
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=

# Port the API server listens on. Defaults to 3021, which is what the Vite
# dev proxy targets - change both together or dev breaks.
PORT=3021


# === Frontend (src/, read at build time by Vite) ===========================

# Override the API base URL. Leave empty for normal local dev and for the
# standard subdirectory deployment; the app derives it from Vite's `base`.
VITE_API_URL=


# === Agent bot (bot/, see bot/.env.example for the full description) =======
#
# These belong in bot/.env rather than here. Listed so the full surface is
# visible in one place.
#
# AUDIOTOOL_PAT           required - full account access, no read-only scope
# AUDIOTOOL_PROJECT_URL   required for spike:live and the producer CLI
# SPIKE_DURATION_S        optional - auto-stop spike:live after N seconds
#
# OAuth path (issue #2, not needed for the MVP - the PAT covers it):
# AUDIOTOOL_CLIENT_ID     not secret; Audiotool uses OAuth2 PKCE as a public
#                         client, so there is NO client secret. An earlier
#                         version of this file listed AUDIOTOOL_CLIENT_SECRET,
#                         which does not exist in Audiotool's flow and is read
#                         by nothing.
# AUDIOTOOL_ACCESS_TOKEN  secret
# AUDIOTOOL_REFRESH_TOKEN secret
