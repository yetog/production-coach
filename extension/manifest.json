{
  "manifest_version": 3,
  "name": "Dr. Zay Push-to-Talk",
  "version": "0.1.0",
  "description": "Talk to Dr. Zay and operate Audiotool through the shared producer agent (issues #55 and #61).",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Dr. Zay"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zaylegend.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://zaylegend.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://zaylegend.com http://localhost http://127.0.0.1"
  },
  "commands": {
    "toggle-ptt": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle push-to-talk with Dr. Zay"
    }
  }
}
